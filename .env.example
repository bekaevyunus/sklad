# Адрес сайта. Если своего домена нет — используйте IP сервера через sslip.io:
# IP 185.10.20.30  ->  DOMAIN=185-10-20-30.sslip.io
DOMAIN=185-10-20-30.sslip.io

# Владелец (создаётся при первом запуске; потом пароль меняется в разделе «Сотрудники»)
ADMIN_NAME=admin
ADMIN_PASSWORD=придумайте-надёжный-пароль
